<!DOCTYPE html>
<html>
<head>
    <title>Register Client</title>
</head>
<body>
    <h1>Register Client</h1>
    <form action="/views/register/client" method="post">
        <div>
            <label for="name">Client Name:</label><br>
            <input type="text" id="name" name="name" required>
        </div>
        <div>
            <label for="redirect_uri">Redirect URI:</label><br>
            <input type="text" id="redirect_uri" name="redirect_uri" required>
        </div>
        <div>
            <label for="grant_types">Grant Types:</label><br>
            <input type="text" id="grant_types" name="grant_types" required>
        </div>
        <div>
            <label for="scope">Scope:</label><br>
            <input type="text" id="scope" name="scope" required>
        </div>
        <div>
            <label for="active">Active:</label><br>
            <input type="checkbox" id="active" name="active">
        </div>
        <div>
            <label for="company_name">Company Name:</label><br>
            <input type="text" id="company_name" name="company_name" required>
        </div>
        <div>
            <label for="company_id">Company ID:</label><br>
            <input type="text" id="company_id" name="company_id" required>
        </div>
        <div>
            <input type="submit" value="Register">
        </div>
    </form>
    <button onclick="location.href='/welcome'" type="button">Back</button>
</body>
</html>