<!DOCTYPE html>
<html>
<head>
    <title>Consent</title>
</head>
<body>
    <h1>Consent</h1>
    <p>Do you give your consent for the application to access your data?</p>
    <form action="/oidc/consent" method="post">
        <input type="hidden" name="client_id" value="<%= client.client_id %>">
        <input type="hidden" name="redirect_uri" value="<%= client.redirect_uri %>">
        <input type="hidden" name="response_type" value="code">
        <input type="hidden" name="scope" value="<%= client.scope.join(' ') %>">
        <input type="hidden" name="state" value="<%= state %>">
        <input type="hidden" name="code_challenge" value="<%= code_challenge %>"> 
        <input type="hidden" name="code_challenge_method" value="<%= code_challenge_method %>"> 
        <input type="submit" value="Yes, I give my consent">
    </form>
</body>
</html>